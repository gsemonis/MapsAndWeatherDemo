

   
<gmp-map center="41.59,-93.62" zoom="7" map-id="MapAndWeatherMap">
    <gmp-place-autocomplete id="pac-input" slot="control-inline-start-block-start" class="controls" placeholder="Search location" />
</gmp-map>
@await Html.PartialAsync("Partials/_WeatherForcastPartial")
@await Html.PartialAsync("Partials/_ForecastCardTemplate")

@section HeadScripts {
    <script>
        (g => {
            var h, a, k,
            p = "The Google Maps JavaScript API",
            c = "google",
            l = "importLibrary",
            q = "__ib__",
            m = document,
            b = window;

            b = b[c] || (b[c] = {});
            var d = b.maps || (b.maps = {}),
                r = new Set(),
                e = new URLSearchParams(),
                u = () =>
                    h ||
                    (h = new Promise(async (resolve, reject) => {
                        a = m.createElement("script");
                        e.set("libraries", [...r] + "");
                        for (k in g)
                            e.set(k.replace(/[A-Z]/g, t => "_" + t[0].toLowerCase()), g[k]);
                        e.set("callback", c + ".maps." + q);
                        a.src = `https://maps.${c}apis.com/maps/api/js?` + e;
                        d[q] = resolve;
                        a.onerror = () => reject(Error(p + " could not load."));
                        a.nonce = m.querySelector("script[nonce]")?.nonce || "";
                        m.head.append(a);
                    }));

            if (d[l]) console.warn(p + " only loads once. Ignoring:", g);
            else {
                d[l] = (lib, ...rest) => r.add(lib) && u().then(() => d[l](lib, ...rest));
            }
        })({
            key: "@ViewBag.Key",
            v: "weekly"
        });
    </script>
}
@section Scripts {
    <script>
        const mapElement = document.querySelector('gmp-map');
        const placeAutocomplete = document.querySelector('gmp-place-autocomplete');
        const forecastModalElement = document.getElementById('weatherForecastModal');
        let innerMap;
        let forecastModal;
        let marker;
        let geoCoder;
        const init = async () => {
            const [] = await Promise.all([ 
                google.maps.importLibrary("maps"),
                google.maps.importLibrary('marker'),
                google.maps.importLibrary('places'),
            ]);
            geoCoder = new google.maps.Geocoder();
            innerMap = mapElement.innerMap;
            innerMap.setOptions({
                mapTypeControl: false
            });
            marker = new google.maps.marker.AdvancedMarkerElement({
                map: innerMap
            });
            forecastModal = bootstrap.Modal.getOrCreateInstance(forecastModalElement);
            placeAutocomplete.addEventListener('gmp-select', placeSelected);
            innerMap.addListener("click", mouseClicked);
        };
        const mouseClicked = (mapsMouseEvent) => {
            const latLong = mapsMouseEvent.latLng.toJSON();            
            marker.position = latLong;
            getWeatherForecast(mapsMouseEvent.latLng);
        };
        const placeSelected = async ({ placePrediction }) => {
            const place = placePrediction.toPlace();
            await place.fetchFields({
                fields: ['displayName', 'formattedAddress', 'location'],
            });
            // If the place has a geometry, then present it on a map.
            if (place.viewport) {
                innerMap.fitBounds(place.viewport);
            }
            else {
                innerMap.setCenter(place.location);
                innerMap.setZoom(13);
            }
            marker.position = place.location;
            getWeatherForecast(place.location)
        };
        const getWeatherForecast = async (latLong) => {
            $('#forecastCardContainer').empty();
            forecastModal.show();
            await setModalLoading(latLong);
            try {
                const pointJson = await getPointsResponseJson(latLong);
                const forecast = await getForecast(pointJson);
            
                const forecastPeriods = forecast.properties.periods;
                const html = generateForecastHTML(forecastPeriods, latLong);
                $('#weatherForecastModal .modal-body').html(html);
                console.log(forecast.properties.periods);
            } catch (error) {
                console.error("Error fetching or rendering forecast:", error);
                $('weatherForecastModalTitle').text('Error');
                $('#weatherForecastModal .modal-body').html(`<div class="alert alert-danger">Could not load forecast: ${error.message}</div>`);
            }                        
        };
        const reverseGeocode = async (latLong) => {            
            const resolveGeoCodePromise = (geoCodeArgs) =>{
                return new Promise((resolve, reject) => {
                    geoCoder.geocode(geoCodeArgs, (results, status) =>{
                        if (status == 'OK') {
                            resolve({results: results, status: status});
                        }
                        else{
                            reject(new Error(`Geocoding failed. ${JSON.stringify(status)}`));
                        }
                    });
                });
            };
            try {
                const {results, status} = await resolveGeoCodePromise({location: latLong.toJSON()});
                if (results){
                    for (const result of results){
                        for (const addressComponent of result.address_components){
                            if (addressComponent.types.includes('locality')){
                                return addressComponent.long_name;
                            }
                        }
                    }
                    return result.results[0].formatted_address;
                }
            }
            catch(error){
                console.log(error);
            }
            return `${latLong.lat().toFixed(2)}, ${latLong.lng().toFixed(2)}`;
        };
        const generateForecastHTML = (periods, latLong) => {
            const container = $(`<div class="p-3">
                                    <div class="row g-2 js-card-grid-target"></div>
                                 </div>`);

            // Get the hidden template element
            const $template = $('.js-forecast-card-template');

            // Loop through the forecast periods
            for (let i = 0; i < Math.min(periods.length, 10); i++) {
                const p = periods[i];

                // 1. CLONE the template
                const $newCard = $template.clone().removeClass('js-forecast-card-template').removeAttr('style');

                // Determine CSS classes and text based on data
                const isDaytime = p.isDaytime;
                const bgColorClass = isDaytime ? 'bg-secondary-subtle' : 'bg-dark-subtle';
                const textColorClass = isDaytime ? 'text-dark' : 'text-white';

                // 2. POPULATE the cloned elements
                $newCard.find('.js-card-bg')
                    .removeClass('bg-secondary-subtle bg-dark-subtle text-dark text-white')
                    .addClass(bgColorClass)
                    .addClass(textColorClass);

                $newCard.find('.js-forecast-name').text(p.name.split(' ')[0]);
                $newCard.find('.js-daytime-status').text(isDaytime ? 'Day' : 'Night');
                $newCard.find('.js-forecast-icon').attr('src', p.icon).attr('alt', p.shortForecast);
                $newCard.find('.js-forecast-temp').text(`${p.temperature}°`);
                $newCard.find('.js-forecast-short-desc').text(p.shortForecast).attr('title', p.detailedForecast);

                // 3. APPEND to the temporary container
                container.find('.js-card-grid-target').append($newCard);
            }

            // Return the full HTML string of the rendered container
            return container.html();
        };
        const setModalLoading = async (latLong) => {
            const result = await reverseGeocode(latLong);
            $('#weatherForecastModalTitle').text(`Loading Forecast for ${result}`);
            document.querySelector('#weatherForecastModal .modal-body').innerHTML = '<div class="text-center p-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Fetching NOAA Data...</p></div>';
        };
        const getPointsResponseJson = async (latLng) => {
            const lat = latLng.lat();
            const lng = latLng.lng();
            const pointUrl = `https://api.weather.gov/points/${lat},${lng}`;
            const pointResonse = await fetch(pointUrl, {
                headers: { "User-Agent": "MapsAndWeatherApp" }
            });
            return await pointResonse.json();
        };
        const getForecast = async (points) => {
            const forecastUrl = points.properties.forecast;
            const forecastResponse = await fetch(forecastUrl, {
                headers: { "User-Agent": "MapsAndWeatherApp" }
            });
            return await forecastResponse.json();
        };
        init();
    </script>

}
